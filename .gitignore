# --- System Files ---
.DS_Store
Thumbs.db
*.tmp

# --- Editor (Neovim) ---
*.swp
*.swo
*.swn
Session.vim
.netrwhist
tags
.tags

# --- Node / pnpm ---
node_modules/
.pnpm-debug.log*
.npm-debug.log*
# Only relevant if pnpm is explicitly configured to use a local store
.pnpm-store/

# --- Build Outputs ---
dist/
build/
out/
.next/

# --- Environment / Secrets ---
.env
.env.local
.env.*.local
!.env.example

# --- IDEs ---
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# --- Python ---
# requirements.txt (pinned) remains the source of truth for the Docker
# build; conda is only used for local development outside containers.
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version

# --- Conda (local development only) ---
.conda/
envs/
conda-meta/
.condarc

# --- Testing / Coverage / Caches ---
coverage/
.nyc_output/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- Generated runtime artifacts ---
# Directory-scoped, not extension-scoped: source images such as
# python/reconstruction-service/datasheets/*.png and future UI assets
# in packages/client are legitimate committed files. Only known
# generated-output directories are ignored, never image extensions
# globally.
output/
**/output/
*.npy

# --- Session storage (RNF-07) ---
# One JSON file per session; keep the directory, ignore its contents.
data/sessions/*.json
!data/sessions/.gitkeep
